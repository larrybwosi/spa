# ==============================================================================
# AURA WELLNESS SANCTUARY - CONFIGURATION TEMPLATE
# ==============================================================================
# This is a template configuration file for local development and docker-compose deployment.
# Copy this file to .env or run the environment generator script to generate it automatically.

# ------------------------------------------------------------------------------
# PORT CONFIGURATIONS (Host mapping)
# ------------------------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000
DB_PORT=5432

# ------------------------------------------------------------------------------
# POSTGRES DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spa_database
DATABASE_URL=postgresql://postgres:postgres@db:5432/spa_database?sslmode=disable

# ------------------------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------------------------
# Used for encrypting session and cookies
BETTER_AUTH_SECRET=generate_on_install

# ------------------------------------------------------------------------------
# NEXT.JS FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# API connection url used by Next.js client
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# SCRYME API INTEGRATION CONFIGURATIONS
# ------------------------------------------------------------------------------
SCRYME_CLIENT_ID=
SCRYME_CLIENT_SECRET=
SCRYME_API_KEY=test-scryme-api-key
SCRYME_ORG_SLUG=spa-test-org
SCRYME_LOCATION_ID=default-location
SCRYME_API_URL=https://api.scryme.tech
